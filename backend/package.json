{
  "name": "dokanpro-backend",
  "version": "1.0.0",
  "description": "DokanPro POS backend — Express + MongoDB + Socket.IO",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node scripts/seed.js",
    "test": "node --test --test-concurrency=1 tests/emit-to-shop.test.js tests/tenant-isolation.test.js",
    "migrate:shop-ownership": "node scripts/migrate-shop-ownership.js --dry-run",
    "migrate:shop-ownership:apply": "node scripts/migrate-shop-ownership.js --apply"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.2.0",
    "mongoose": "^8.8.1",
    "morgan": "^1.10.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
