NODE_ENV=development
PORT=4000


# MongoDB
MONGODB_URI="xxxxxxxx"

# Isolated test DB only (required for yarn test tenant isolation).
# Database name MUST contain "test". Do not reuse MONGODB_URI / production.
# TEST_MONGODB_URI=mongodb://127.0.0.1:27017/dokanpro_phase1_test

# JWT
JWT_SECRET=xxxxxxxxxxxx
JWT_EXPIRES_IN=7d

# CORS — comma separated origins, * for all
CORS_ORIGIN=http://localhost:5174/

# Bcrypt
BCRYPT_ROUNDS=10
